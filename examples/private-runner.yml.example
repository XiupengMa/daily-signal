# Install only in a separately controlled PRIVATE deployment repository.
name: Daily Signal
on:
  schedule:
    # GitHub cron uses UTC. 15:07 = 08:07 PDT; 16:07 = 08:07 PST.
    # Python admits only 08:00–11:59 Pacific; extra seasonal slots skip safely.
    - cron: '7,37 15-19 * * *'
  workflow_dispatch:
    inputs:
      resume_run_id:
        description: "Optional failed run ID to resume; prior spend remains charged"
        required: false
        type: string
permissions:
  contents: read
  actions: read
concurrency:
  group: daily-signal-production
  cancel-in-progress: false
jobs:
  briefing:
    defaults:
      run:
        working-directory: runner
    if: github.event.repository.private == true
    runs-on: ubuntu-latest
    timeout-minutes: 55
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with: {persist-credentials: false}
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: runner/requirements.lock
      - name: Install dependencies
        run: |
          pip install --require-hashes -r requirements.lock
          sudo apt-get update -qq
          sudo apt-get install -y ffmpeg fonts-noto-cjk
      - name: Policy tests
        run: python -m unittest discover -s tests -v
      - name: Restore private editorial audit for an explicit recovery
        if: inputs.resume_run_id != ''
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: daily-signal-audit-${{ inputs.resume_run_id }}
          run-id: ${{ inputs.resume_run_id }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
          path: runner/recovery
      - name: Locate private media recovery
        if: inputs.resume_run_id != ''
        id: recovery_media
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          RESUME_RUN_ID: ${{ inputs.resume_run_id }}
        run: |
          case "$RESUME_RUN_ID" in ''|*[!0-9]*) exit 1;; esac
          gh api "repos/$GITHUB_REPOSITORY/actions/runs/$RESUME_RUN_ID/artifacts?per_page=100" --jq '.artifacts[] | select(.expired == false) | .name' > artifact-names.txt
          if grep -Fxq "daily-signal-recovery-$RESUME_RUN_ID" artifact-names.txt; then
            echo "available=true" >> "$GITHUB_OUTPUT"
          fi
      - name: Restore completed recordings and saved speech segments
        if: steps.recovery_media.outputs.available == 'true'
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: daily-signal-recovery-${{ inputs.resume_run_id }}
          run-id: ${{ inputs.resume_run_id }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
          path: runner/recovery
      - name: Generate, review, narrate, and publish
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          BRIEFING_SITE_URL: ${{ vars.BRIEFING_SITE_URL }}
          BRIEFING_PUBLISH_TOKEN: ${{ secrets.BRIEFING_PUBLISH_TOKEN }}
          RESUME_RUN_ID: ${{ inputs.resume_run_id }}
          RECOVERY_DIR: recovery
          PYTHONUNBUFFERED: "1"
          PRIOR_SPEND_DATE: ${{ vars.PRIOR_SPEND_DATE }}
          PRIOR_SPEND_USD: ${{ vars.PRIOR_SPEND_USD }}
        run: |
          if [ "$GITHUB_EVENT_NAME" = "schedule" ]; then
            python -m daily_signal --scheduled
          else
            python -m daily_signal
          fi
      - name: Save private audit trail
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: daily-signal-audit-${{ github.run_id }}
          path: |
            runner/work/**/*.json
          retention-days: 7
          if-no-files-found: ignore
      - name: Preserve completed media for failed-run recovery
        if: failure()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: daily-signal-recovery-${{ github.run_id }}
          path: |
            runner/work/**/*.mp3
            runner/work/**/*.mp4
            runner/work/**/*.jpg
            runner/work/**/chunks/*.wav
          retention-days: 2
          if-no-files-found: ignore
