{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-signal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "daily-signal-media"
    }
  ],
  "vars": {
    "DEMO_MODE": "true"
  }
}
